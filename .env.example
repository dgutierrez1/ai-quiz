# --- DB ---
# Local dev (docker-compose Postgres): DATABASE_URL=postgres://ai_quiz:ai_quiz@localhost:5432/ai_quiz
# Production (Neon free): DATABASE_URL=postgres://USER:PASS@HOST.neon.tech/ai_quiz?sslmode=require
DATABASE_URL=postgres://ai_quiz:ai_quiz@localhost:5432/ai_quiz

# --- LLM defaults (per-session override allowed) ---
LLM_PROVIDER=minimax
LLM_MODEL=MiniMax-M3

# --- Provider keys ---
# v1 scope is MiniMax (default) + OpenRouter free models (opt-in) only.
# Groq / OpenAI / Anthropic / Ollama are deferred to v2 — do NOT add their keys.
# Missing keys silently disable that tier (default-deny filtering on /api/config/providers).
MINIMAX_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_ANTHROPIC_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODELS=MiniMax-M3,MiniMax-M2.7,MiniMax-M2.7-highspeed
# MINIMAX_REGION=intl  # uncomment to switch to api.minimax.io

# --- Web search (post-quiz only) ---
TAVILY_API_KEY=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- HTTP / deploy ---
WEB_ORIGIN=http://localhost:3000
WEB_ORIGIN_REGEX=^https://.*\.vercel\.app$
API_PORT=4000
NODE_ENV=development

# --- Rate limiting (per-user AND per-IP; stricter wins) ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=30