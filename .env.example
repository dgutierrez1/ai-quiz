# Local development environment.
# DO NOT commit real secrets. The api validates this file at boot.

# Required
DATABASE_URL=postgres://ai_quiz:ai_quiz@localhost:5432/ai_quiz
API_PORT=4000
NODE_ENV=development

# Test-only. Comma-separated list of ports to serve from @ai-quiz/test-doubles
# instead of the real adapter: `llm`, `ingestion`, or both. Set by the api test
# suite and by Playwright so runs need no network and no provider credits.
# Boot FAILS if this is non-empty while NODE_ENV=production — fake adapters
# fabricate content and must never reach a real user.
AI_QUIZ_FAKE_ADAPTERS=

# Web origin allow-list (exact match in production, regex in development)
WEB_ORIGIN=http://localhost:3000
WEB_ORIGIN_REGEX=^http://localhost:3[0-9]{3}$

# MiniMax-M3 (default) and OpenRouter free models are the only supported tiers in v1.
# At least one key is REQUIRED to generate a quiz or to chat. With both empty the
# api still boots, but any LLM call fails with a typed LlmNotConfiguredError — it
# never fabricates content. For deterministic offline runs use AI_QUIZ_FAKE_ADAPTERS
# below; a missing key is a misconfiguration, not a mock trigger.
# MINIMAX_REGION=intl selects https://api.minimax.io (international keys).
# The default is the mainland host https://api.minimaxi.com — the two do NOT
# share credentials, and a mismatch returns a confusing 401 "invalid api key".
MINIMAX_REGION=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=

# Fly.io single-machine guard. Set FLY_APP_NAME to enable the check.
FLY_APP_NAME=
MAX_MACHINES_RUNNING=1

# Web search (post-quiz chat only — Story 4.2). Leave empty to disable the
# tavily_search tool; chat still works without it (document-grounded answers,
# gap analysis). NEVER used on the quiz-generation path (closed-world).
TAVILY_API_KEY=

# Langfuse (Story 1.6/4.2/4.4). Leave empty to use the no-op tracing adapter.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Maintenance route auth (Story 4.4 — 7-day chat scrub, called by the
# keep-warm cron). Do NOT commit a real value; set as a Fly secret + GitHub
# Actions repo secret in production.
MAINTENANCE_TOKEN=
