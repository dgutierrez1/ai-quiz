{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./",
    "types": ["node"],
    "lib": ["es2025"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*", "test/**/*", "drizzle.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/*.tsbuildinfo",
    "test/fixtures/lint-guard/**"
  ]
}
